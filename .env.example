# GEMINI_API_KEY: Required for Gemini AI API calls (Reverse image prompt & Metadata generator)
# AI Studio automatically injects this at runtime.
GEMINI_API_KEY=

# GEMINI_MODEL: Optional override for model name (default: gemini-3.8-flash)
GEMINI_MODEL=

# ADOBE_STOCK_API_KEY: Optional. When provided, connects to the official Adobe Stock search API.
# Without it, the Adobe Analytics tool runs seamlessly in high-fidelity demo mode.
ADOBE_STOCK_API_KEY=

# ADOBE_STOCK_PRODUCT_NAME: Application header for Adobe Stock API requests (default: DOCTORx/1.0)
ADOBE_STOCK_PRODUCT_NAME=
